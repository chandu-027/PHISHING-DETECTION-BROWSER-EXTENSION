{
  "manifest_version": 3,
  "name": "TrustNet",
  "version": "1.0.0",
  "description": "AI-powered, zero-dependency, real-time client-side phishing URL detector.",
  "permissions": [
    "webNavigation",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrustNet Dashboard"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
